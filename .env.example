# Copy to .env and fill in. Never commit .env.
# MCP endpoint of the local test site
WP_MCP_URL=https://example.test/wp-json/gn-mcp/mcp

# Full-rights identity (Administrator)
EVALS_FULL_USER=evals-full
EVALS_FULL_APP_PASSWORD=

# Drafts-only identity (Contributor: can write drafts, cannot publish)
EVALS_DRAFTS_ONLY_USER=evals-drafts-only
EVALS_DRAFTS_ONLY_APP_PASSWORD=
